<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splashBg">

    <!-- Centered content -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <!-- Logo / Emblem circle -->
        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal">

            <!-- Outer ring -->
            <View
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/circle_teal_ring" />

            <!-- Inner circle -->
            <View
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="center"
                android:background="@drawable/circle_teal_solid" />

            <!-- "S" text -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="S"
                android:textColor="@color/white"
                android:textSize="52sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

        </FrameLayout>

        <!-- App name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="SAPAuto"
            android:textColor="@color/tealLight"
            android:textSize="34sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:fontFamily="sans-serif-medium" />

        <!-- Version badge -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="V8.1"
            android:textColor="#6b7280"
            android:textSize="14sp"
            android:letterSpacing="0.3" />

        <!-- Subtitle Arabic -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="منظومة إدارة الالتزامات الضريبية"
            android:textColor="@color/textSecondary"
            android:textSize="13sp"
            android:gravity="center"
            android:fontFamily="sans-serif" />

        <!-- Progress bar -->
        <ProgressBar
            android:id="@+id/splashProgress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="200dp"
            android:layout_height="4dp"
            android:layout_marginTop="40dp"
            android:progressTint="@color/teal"
            android:progressBackgroundTint="#1f2937"
            android:indeterminate="true" />

        <!-- Loading text -->
        <TextView
            android:id="@+id/splashStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/connecting"
            android:textColor="#6b7280"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Bottom version watermark -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:text="© 2026 SAPAuto Enterprise"
        android:textColor="#374151"
        android:textSize="11sp" />

</FrameLayout>
